{
  "rewrites": [
    { "source": "/cal.ics", "destination": "/api/cal" },
    { "source": "/cfps.json", "destination": "/data/cfps.json" }
  ],
  "headers": [
    { "source": "/data/cfps.json", "headers": [ { "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cache-Control", "value": "public, max-age=600" } ] }
  ]
}
